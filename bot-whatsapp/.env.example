# Porta do servidor de callback (o backend chama esta porta ao confirmar o Pix)
BOT_PORT=3334

# Backend
API_URL=http://localhost:3333
INTERNAL_API_KEY="chave-interna-bot-troque-tambem"

# Onde a sessao do WhatsApp e salva (nao versionar esta pasta)
SESSION_PATH=./auth_session

# Personalizacao das mensagens
COMPANY_NAME="Minha Revenda"
SUPPORT_NUMBER="5511999999999"
APP_DOWNLOAD_URL=""

# Numeros com permissao administrativa no bot (separados por virgula)
ADMIN_NUMBERS="5511999999999"

# Fallback de confirmacao quando o webhook nao chega
POLL_INTERVAL_MS=20000
POLL_MAX_ATTEMPTS=45
