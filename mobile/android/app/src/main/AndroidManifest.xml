<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Leitura da operadora do chip (TelephonyManager) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Rede -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Localizacao: opcional. O app pede com um dialogo proprio e continua
         funcionando se o usuario recusar. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- VPN em foreground.
         O android:minSdkVersion abaixo repete exatamente o que o plugin
         flutter_v2ray declara: quando a mesma permissao aparece com atributos
         diferentes, o merger de manifesto aborta o build. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34"
        tools:node="merge" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Mantem o CPU vivo com a tela apagada: sem isto o Doze Mode suspende o
         processo e mata os sockets do tunel. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Janela flutuante de status (overlay). Concedida pelo usuario numa tela
         propria do sistema, nao por dialogo de runtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- OTA: instalar o APK baixado dentro do proprio app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Ver a lista de apps instalados (tela de bypass). QUERY_ALL_PACKAGES e
         permissao sensivel na Play Store; para um app de VPN com split
         tunneling ela e justificavel, mas se for publicar, prefira declarar
         apenas os pacotes-alvo em <queries>. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- O app so faz sentido em aparelho com telefonia; remova se quiser
         publicar tambem para tablets sem chip. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:label="Tunnel App"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VpnService: o BIND_VPN_SERVICE so pode ser concedido ao sistema,
             e o intent-filter e o que faz o Android reconhecer o servico. -->
        <service
            android:name=".tunnel.TunnelVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tunel VPN mantido ativo enquanto o usuario esta conectado" />
        </service>

        <!-- Janela flutuante de status. Nao e foreground: TYPE_APPLICATION_OVERLAY
             mantem a view viva sem exigir notificacao propria; quem segura o
             processo e a notificacao do TunnelVpnService. -->
        <service
            android:name=".tunnel.OverlayService"
            android:exported="false" />

        <!-- FileProvider: entrega o APK baixado ao instalador do Android via
             content:// (a partir do Android 7 nao se passa file:// entre apps). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Apps com tela de abertura, para popular a lista de bypass. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
