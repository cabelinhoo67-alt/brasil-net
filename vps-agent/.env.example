# URL do backend. Use HTTPS em producao: o token e os hashes trafegam aqui.
API_URL=https://api.seudominio.com.br

# Gerado no painel: Servidores > (o servidor) > gerar token do agente
AGENT_TOKEN=""

# Grupo que marca as contas gerenciadas. O agente NUNCA toca em conta fora dele.
TUNNEL_GROUP=tunnel

# Sem shell: o cliente so precisa de encaminhamento de portas.
TUNNEL_SHELL=/usr/sbin/nologin

LIMITS_DIR=/etc/security/limits.d

# Frequencia de busca na fila
POLL_INTERVAL_MS=10000

# Reconciliacao completa (conserta divergencias)
SYNC_INTERVAL_MS=900000

BATCH_SIZE=25

# true = so registra o que faria, sem alterar o sistema
DRY_RUN=false

LOG_LEVEL=info
