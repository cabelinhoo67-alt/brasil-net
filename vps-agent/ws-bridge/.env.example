# Ponte WebSocket -> SSH (fallback wss:// do app movel).
#
# O bridge so escuta em 127.0.0.1:porta_alta — quem faz TLS e repassa o
# upgrade e o Nginx (location /tun -> proxy_pass http://127.0.0.1:7301),
# entao estas variaveis nao precisam mudar na maioria das instalacoes.
#
# Copie para /opt/tunnel-ws-bridge/.env na VPS.

# Porta local onde o bridge escuta os upgrades vindos do Nginx.
WS_BRIDGE_PORT=7301

# O sshd local que recebe o trafego SSH encapsulado.
SSH_HOST=127.0.0.1
SSH_PORT=22
