# ------------------------------------------------------------------
# Copie para .env e ajuste os valores
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3333

# PostgreSQL (docker-compose ja sobe com estes dados)
DATABASE_URL="postgresql://tunnel:tunnel123@localhost:5432/tunneldb?schema=public"

# Troque por uma string longa e aleatoria antes de ir para producao
JWT_SECRET="troque-esta-chave-por-uma-string-bem-longa-e-aleatoria"
JWT_PANEL_EXPIRES=8h
JWT_APP_EXPIRES=7d

# Chave compartilhada entre backend e bot do WhatsApp
INTERNAL_API_KEY="chave-interna-bot-troque-tambem"

# Mercado Pago (Painel > Suas integracoes > Credenciais de producao)
MP_ACCESS_TOKEN=""
PIX_EXPIRATION_MINUTES=30

# Onde o backend avisa o bot que o Pix foi confirmado
BOT_CALLBACK_URL="http://localhost:3334/internal/order-paid"

# Sessao sem heartbeat por mais que isso e considerada encerrada
SESSION_TIMEOUT_SECONDS=120

# Credenciais criadas pelo seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
